# ScenePilot Generation API Keys
# Copy relevant lines to your .env.local file

# ── Platform (hosted) generation ──────────────────────────────────────────
# These keys are used when users choose "Platform" mode (credits consumed)
VITE_FAL_API_KEY=fal_key_your_key_here
VITE_RUNWAY_API_KEY=rw_your_key_here

# Optional: override default models
VITE_FAL_IMAGE_MODEL=fal-ai/flux/dev
VITE_RUNWAY_VIDEO_MODEL=gen3a_turbo

# ── Supabase (auth) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Billing (Whop / Paddle) ────────────────────────────────────────────────
VITE_BILLING_ENABLED=true
