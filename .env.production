# .env.production
# 这个文件只保留非敏感的构建时默认值。
# 敏感的 VITE_SUPABASE_ANON_KEY 等由 GitHub Actions workflow 注入，不放在这里。
# Vite 加载优先级：shell env (Actions inject) > .env.production > .env
# 所以这里设置的值会被 workflow 里的 env: 块覆盖。

# 明确声明为空，防止旧的 .env.production 里有错误值残留并意外生效
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE_URL=
