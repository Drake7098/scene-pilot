{
  "name": "scene-pilot",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "engine:lock:check": "node scripts/engine-library-lock.mjs --check",
    "engine:lock:update": "node scripts/engine-library-lock.mjs --update",
    "engine:lock:print": "node scripts/engine-library-lock.mjs --print",
    "health:local": "node scripts/health-local-runtime.mjs",
    "tracker:list": "node scripts/dev-tracker.mjs list",
    "tracker:next": "node scripts/dev-tracker.mjs next",
    "tracker:summary": "node scripts/dev-tracker.mjs summary",
    "tracker:board": "node scripts/render-tracker-board.mjs",
    "tracker:show": "node scripts/dev-tracker.mjs show",
    "tracker:add": "node scripts/dev-tracker.mjs add",
    "tracker:move": "node scripts/dev-tracker.mjs move",
    "tracker:test": "node scripts/dev-tracker.mjs test",
    "tracker:note": "node scripts/dev-tracker.mjs note",
    "tracker:remind": "node scripts/dev-tracker.mjs remind",
    "tracker:notify": "node scripts/dev-tracker.mjs notify",
    "tracker:check": "node scripts/dev-tracker.mjs check",
    "db:migrate:local": "npx wrangler d1 execute scene-pilot-db --local --file=db/migrations/0000_observability.sql && npx wrangler d1 execute scene-pilot-db --local --file=db/migrations/0001_billing_core.sql && npx wrangler d1 execute scene-pilot-db --local --file=db/migrations/0002_auth_core.sql && npx wrangler d1 execute scene-pilot-db --local --file=db/migrations/0003_legal_consents.sql",
    "db:seed:local": "npx wrangler d1 execute scene-pilot-db --local --file=db/seeds/0001_products.sql",
    "db:init:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:query:local": "npx wrangler d1 execute scene-pilot-db --local --command",
    "ab:build": "npm run engine:lock:check && tsc -p tests/ab/tsconfig.json",
    "ab:images": "npm run ab:build && node tests/ab/dist/runners/run-images.js",
    "ab:videos": "npm run ab:build && node tests/ab/dist/runners/run-videos.js",
    "ab:report": "npm run ab:build && node tests/ab/dist/reports/render-report.js",
    "ab:all": "npm run ab:build && node tests/ab/dist/runners/run-all.js",
    "local-ab:build": "npm run engine:lock:check && tsc -p tests/local-ab/tsconfig.json && node tests/local-ab/scripts/fix-esm-imports.mjs tests/local-ab/dist",
    "local-ab:baseline": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/llm/generate-baseline.js",
    "local-ab:three-rounds": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/llm/run-three-rounds.js",
    "local-ab:judge": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/llm/judge-helper.js",
    "local-ab:comfy": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/comfyui/run-batch.js",
    "local-ab:comfy:import": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/comfyui/import-results-to-scored.js",
    "local-ab:draw:queue": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/drawthings/prepare-queue.js",
    "local-ab:draw:http": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/drawthings/run-http.js",
    "local-ab:draw:import": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/drawthings/import-images-to-scored.js",
    "local-ab:draw": "npm run local-ab:draw:queue && npm run local-ab:draw:import",
    "local-ab:summary": "npm run local-ab:build && node tests/local-ab/dist/tests/local-ab/reports/render-summary.js",
    "intent-benchmark:build": "npm run engine:lock:check && tsc -p tests/intent-benchmark/tsconfig.json",
    "intent-benchmark:dataset": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/generate-dataset.js",
    "intent-benchmark:eval:baseline": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/evaluate.js baseline",
    "intent-benchmark:eval:round1": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/evaluate.js round1",
    "intent-benchmark:eval:round2": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/evaluate.js round2",
    "intent-benchmark:eval:round3": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/evaluate.js round3",
    "intent-benchmark:rounds": "npm run intent-benchmark:eval:baseline && npm run intent-benchmark:eval:round1 && npm run intent-benchmark:eval:round2 && npm run intent-benchmark:eval:round3 && node tests/intent-benchmark/dist/tests/intent-benchmark/run-rounds.js",
    "intent-benchmark:images": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/image-sample.js",
    "intent-benchmark:final-report": "npm run intent-benchmark:build && node tests/intent-benchmark/dist/tests/intent-benchmark/final-report.js",
    "intent-benchmark:all": "npm run intent-benchmark:dataset && npm run intent-benchmark:rounds && npm run intent-benchmark:images && npm run intent-benchmark:final-report",
    "robots:test": "npm run engine:lock:check && npx playwright test -c tests/robots/playwright.config.ts",
    "robots:test:ui": "npm run engine:lock:check && npx playwright test -c tests/robots/playwright.config.ts --ui",
    "robots:test:headed": "npm run engine:lock:check && npx playwright test -c tests/robots/playwright.config.ts --headed",
    "robots:run": "npm run engine:lock:check && node tests/robots/scripts/run-robots.mjs",
    "robots:summary": "node tests/robots/scripts/generate-summary.mjs",
    "robots:functional:audit": "node tests/robots/scripts/audit-functional-coverage.mjs",
    "robots:gate": "node tests/robots/scripts/assert-gates.mjs",
    "robots:dashboard": "node tests/robots/scripts/serve-dashboard.mjs",
    "robots:prompt:simulate": "node tests/robots/scripts/simulate-prompt-scenarios.mjs",
    "robots:prompt:evaluate": "node tests/robots/scripts/evaluate-prompts.mjs",
    "robots:prompt:check": "npm run robots:prompt:simulate && npm run robots:prompt:evaluate",
    "pro-sim:round1:preview": "npm run local-ab:build && node tests/pro-workbench/scripts/simulate-round1-preview.mjs",
    "pro-sim:round1:audit": "npm run local-ab:build && node tests/pro-workbench/scripts/run-round-audit.mjs pro 120",
    "quick-sim:round1:audit": "npm run local-ab:build && node tests/pro-workbench/scripts/run-round-audit.mjs quick 120",
    "robots:prompt:ab:clean": "PROMPT_CONFLICT_INJECT_RATE=0 PROMPT_ACTION_CONFLICT_INJECT_RATE=0 node tests/robots/scripts/simulate-prompt-scenarios.mjs 100 tests/robots/artifacts/prompt-eval/ab-clean/simulated && node tests/robots/scripts/evaluate-prompts.mjs tests/robots/artifacts/prompt-eval/ab-clean/simulated tests/robots/artifacts/prompt-eval/ab-clean",
    "robots:prompt:ab:conflict": "PROMPT_CONFLICT_INJECT_RATE=0.35 PROMPT_ACTION_CONFLICT_INJECT_RATE=0.35 node tests/robots/scripts/simulate-prompt-scenarios.mjs 100 tests/robots/artifacts/prompt-eval/ab-conflict/simulated && node tests/robots/scripts/evaluate-prompts.mjs tests/robots/artifacts/prompt-eval/ab-conflict/simulated tests/robots/artifacts/prompt-eval/ab-conflict",
    "robots:prompt:ab:check": "npm run robots:prompt:ab:clean && npm run robots:prompt:ab:conflict",
    "paddle:webhook:replay": "node scripts/paddle-webhook-replay.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "check:env:release": "node scripts/check-env-release.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:cloudflare:audit": "node scripts/cloudflare-pages-release-audit.mjs",
    "release:cloudflare:sync-secrets": "node scripts/cloudflare-pages-secret-sync.mjs",
    "release:secrets:setup": "bash scripts/release-secrets-keychain.sh setup",
    "release:secrets:status": "bash scripts/release-secrets-keychain.sh status",
    "release:secrets:clear": "bash scripts/release-secrets-keychain.sh clear",
    "release:safe": "bash scripts/release-safe.sh",
    "release:orchestrate": "node scripts/release-orchestrate.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
