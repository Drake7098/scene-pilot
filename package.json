{
  "name": "scene-pilot",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "robots:test": "npx playwright test -c tests/robots/playwright.config.ts",
    "robots:test:ui": "npx playwright test -c tests/robots/playwright.config.ts --ui",
    "robots:test:headed": "npx playwright test -c tests/robots/playwright.config.ts --headed",
    "robots:run": "node tests/robots/scripts/run-robots.mjs",
    "robots:summary": "node tests/robots/scripts/generate-summary.mjs",
    "robots:dashboard": "node tests/robots/scripts/serve-dashboard.mjs",
    "robots:prompt:simulate": "node tests/robots/scripts/simulate-prompt-scenarios.mjs",
    "robots:prompt:evaluate": "node tests/robots/scripts/evaluate-prompts.mjs",
    "robots:prompt:check": "npm run robots:prompt:simulate && npm run robots:prompt:evaluate",
    "robots:prompt:ab:clean": "PROMPT_CONFLICT_INJECT_RATE=0 PROMPT_ACTION_CONFLICT_INJECT_RATE=0 node tests/robots/scripts/simulate-prompt-scenarios.mjs 100 tests/robots/artifacts/prompt-eval/ab-clean/simulated && node tests/robots/scripts/evaluate-prompts.mjs tests/robots/artifacts/prompt-eval/ab-clean/simulated tests/robots/artifacts/prompt-eval/ab-clean",
    "robots:prompt:ab:conflict": "PROMPT_CONFLICT_INJECT_RATE=0.35 PROMPT_ACTION_CONFLICT_INJECT_RATE=0.35 node tests/robots/scripts/simulate-prompt-scenarios.mjs 100 tests/robots/artifacts/prompt-eval/ab-conflict/simulated && node tests/robots/scripts/evaluate-prompts.mjs tests/robots/artifacts/prompt-eval/ab-conflict/simulated tests/robots/artifacts/prompt-eval/ab-conflict",
    "robots:prompt:ab:check": "npm run robots:prompt:ab:clean && npm run robots:prompt:ab:conflict"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
