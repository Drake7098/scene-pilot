{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "../..",
    "types": ["node"],
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "./**/*.ts",
    "../../src/utils/briefParser.ts",
    "../../src/types/intentPlan.ts",
    "../../src/i18n.ts"
